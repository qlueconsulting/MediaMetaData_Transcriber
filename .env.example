# ==============================================================================
# MediaMetaData_Transcriber Configuration
# ==============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Persistent storage paths
# The jobs directory hosts individual subdirectories per job: /srv/storage/jobs/{job_id}/
STORAGE_DIR=/srv/storage/jobs
MODEL_DIR=/srv/storage/models

# Guardrail Limits
# 1200 seconds = 20 minutes strict ceiling
MAX_DURATION_SECONDS=1200
# 26,214,400 bytes = 25 megabytes strict ceiling
MAX_AUDIO_SIZE_BYTES=26214400

# Audio Extraction Encoding (16kHz mono MP3, 64kbps)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BITRATE=64k

# Local GPU Speech-to-Text (faster-whisper)
# Optimized for NVIDIA RTX 2060 Super 8GB VRAM
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE_INDEX=0
WHISPER_BEAM_SIZE=5

# Groq Cloud Whisper API Fallback
# Used when GPU is unavailable or on CUDA OOM
ENABLE_GROQ_FALLBACK=true
FORCE_GROQ_FALLBACK=false
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# yt-dlp Network & Residential Settings
# Helps bypass YouTube bot detection and 403 / 429 throttling
YTDLP_PLAYER_CLIENTS=web,android
YTDLP_SOCKET_TIMEOUT=30
YTDLP_RETRIES=5
YTDLP_PROXY=
